          """A small 7-Zip (.7z) reader using only Python's own lzma module (LZMA, LZMA2, BCJ x86, Delta and Copy).
          build_sounds.py uses it only when the 7z program isn't there and can't be installed.
            python3 sevenz.py list ARCHIVE
            python3 sevenz.py extract ARCHIVE OUTDIR [ending ...]      e.g. .wav .cfg .dat"""
          import lzma, os, struct, sys


          class R:
              def __init__(s, b): s.b, s.p = b, 0
              def byte(s): v = s.b[s.p]; s.p += 1; return v
              def bytes(s, n): v = s.b[s.p:s.p + n]; s.p += n; return v
              def u32(s): v = struct.unpack_from("<I", s.b, s.p)[0]; s.p += 4; return v
              def num(s):
                  first = s.byte(); mask = 0x80; val = 0
                  for i in range(8):
                      if not first & mask:
                          return val | ((first & (mask - 1)) << (8 * i))
                      val |= s.byte() << (8 * i); mask >>= 1
                  return val
              def bits(s, n):
                  out, cur, m = [], 0, 0
                  for _ in range(n):
                      if m == 0: cur, m = s.byte(), 0x80
                      out.append(bool(cur & m)); m >>= 1
                  return out
              def defined(s, n):
                  return [True] * n if s.byte() else s.bits(n)


          def pack_info(r):
              pos = r.num(); n = r.num(); sizes = []
              while True:
                  t = r.byte()
                  if t == 0: break
                  if t == 9: sizes = [r.num() for _ in range(n)]
                  elif t == 10: [r.u32() for x in r.defined(n) if x]
              return pos, sizes


          def folder(r):
              coders = []
              for _ in range(r.num()):
                  f = r.byte(); mid = r.bytes(f & 0xF); ni = no = 1
                  if f & 0x10: ni, no = r.num(), r.num()
                  props = r.bytes(r.num()) if f & 0x20 else b""
                  coders.append({"id": mid.hex(), "ni": ni, "no": no, "props": props})
              tot_out = sum(c["no"] for c in coders); tot_in = sum(c["ni"] for c in coders)
              binds = [(r.num(), r.num()) for _ in range(tot_out - 1)]
              npacked = tot_in - len(binds)
              packed = [r.num() for _ in range(npacked)] if npacked > 1 else [next(i for i in range(tot_in) if i not in [b[0] for b in binds])]
              return {"coders": coders, "binds": binds, "packed": packed}


          def main_out(f):
              bound = {b[1] for b in f["binds"]}
              return next(i for i in range(sum(c["no"] for c in f["coders"])) if i not in bound)


          def unpack_info(r):
              assert r.byte() == 11
              n = r.num(); assert r.byte() == 0
              fs = [folder(r) for _ in range(n)]
              assert r.byte() == 12
              for f in fs: f["sizes"] = [r.num() for _ in range(sum(c["no"] for c in f["coders"]))]
              t = r.byte()
              if t == 10:
                  for f, x in zip(fs, r.defined(n)):
                      if x: f["crc"] = r.u32()
                  t = r.byte()
              assert t == 0
              return fs


          def substreams(r, fs):
              counts = [1] * len(fs); sizes = []; t = r.byte()
              if t == 13: counts = [r.num() for _ in fs]; t = r.byte()
              for f, c in zip(fs, counts):
                  if c == 0: continue
                  part = [r.num() for _ in range(c - 1)] if t == 9 else []
                  part.append(f["sizes"][main_out(f)] - sum(part)); sizes += part
              if t == 9: t = r.byte()
              if t == 10:
                  nd = sum(c for f, c in zip(fs, counts) if not (c == 1 and "crc" in f))
                  [r.u32() for x in r.defined(nd) if x]; t = r.byte()
              assert t == 0, t
              return counts, sizes


          def streams_info(r):
              pi, fs, ss = None, [], None; t = r.byte()
              if t == 6: pi = pack_info(r); t = r.byte()
              if t == 7: fs = unpack_info(r); t = r.byte()
              if t == 8: ss = substreams(r, fs); t = r.byte()
              assert t == 0
              if ss is None: ss = ([1] * len(fs), [f["sizes"][main_out(f)] for f in fs])
              return pi, fs, ss


          def lzma_filter(c):
              cid, p = c["id"], c["props"]
              if cid == "030101":
                  d = p[0]
                  return {"id": lzma.FILTER_LZMA1, "dict_size": struct.unpack("<I", p[1:5])[0], "lc": d % 9, "lp": (d // 9) % 5, "pb": d // 45}
              if cid == "21":
                  b = p[0]
                  return {"id": lzma.FILTER_LZMA2, "dict_size": (2 | (b & 1)) << (b // 2 + 11) if b < 40 else 0xFFFFFFFF}
              if cid == "03":
                  return {"id": lzma.FILTER_DELTA, "dist": p[0] + 1}
              if cid == "03030103":
                  return {"id": lzma.FILTER_X86}
              raise NotImplementedError("method " + cid)


          def decode_folder(buf, pi, fs, fi):
              """One folder's data: the packed stream through its coders (one lzma filter chain, last coder first)."""
              f = fs[fi]; coders = f["coders"]
              in_of, out_of, k_in, k_out = [], [], 0, 0
              for c in coders: in_of.append(k_in); out_of.append(k_out); k_in += c["ni"]; k_out += c["no"]
              if len(f["packed"]) != 1 or any(c["ni"] != 1 or c["no"] != 1 for c in coders):
                  raise NotImplementedError("coder with several streams (BCJ2)")
              first_pack = sum(len(x["packed"]) for x in fs[:fi])
              start = 32 + pi[0] + sum(pi[1][:first_pack])
              data = buf[start:start + pi[1][first_pack]]
              by_in = lambda i: next(j for j in range(len(coders)) if in_of[j] == i)
              order, j = [], by_in(f["packed"][0])
              while True:                          # from the packed stream outwards
                  order.append(coders[j])
                  nxt = [b for b in f["binds"] if b[1] == out_of[j]]
                  if not nxt: break
                  j = by_in(nxt[0][0])
                  if len(order) > 4: raise RuntimeError("bad folder")
              size = f["sizes"][main_out(f)]
              if [c["id"] for c in order] == ["00"]:
                  return data[:size]
              chain = [lzma_filter(c) for c in reversed(order) if c["id"] != "00"]
              if chain[-1]["id"] not in (lzma.FILTER_LZMA1, lzma.FILTER_LZMA2):
                  raise NotImplementedError("folder doesn't start with LZMA")
              return lzma.LZMADecompressor(lzma.FORMAT_RAW, filters=chain).decompress(data, size)[:size]


          def read(path):
              buf = open(path, "rb").read()
              assert buf[:6] == b"7z\xbc\xaf\x27\x1c", "not a 7z archive"
              off, size = struct.unpack_from("<QQ", buf, 12)
              r = R(buf[32 + off: 32 + off + size]); t = r.byte()
              while t == 0x17:                     # the header is itself packed
                  pi, fs, ss = streams_info(r)
                  r = R(decode_folder(buf, pi, fs, 0)); t = r.byte()
              assert t == 1
              t = r.byte(); pi = fs = None; ss = ([], [])
              if t == 2:                           # archive properties
                  while r.byte(): r.bytes(r.num())
                  t = r.byte()
              if t == 3: streams_info(r); t = r.byte()
              if t == 4: pi, fs, ss = streams_info(r); t = r.byte()
              files = []
              if t == 5:
                  n = r.num(); empty = [False] * n; names = []
                  while True:
                      pt = r.byte()
                      if pt == 0: break
                      sz = r.num(); start = r.p
                      if pt == 14: empty = r.bits(n)
                      elif pt == 17:
                          r.byte(); names = r.bytes(sz - 1).decode("utf-16-le").split("\x00")[:n]
                      r.p = start + sz
                  files = [{"name": names[i] if i < len(names) else f"file{i}", "empty": empty[i]} for i in range(n)]
              counts, sizes = ss
              k = fi = inner = pos = 0
              for f in files:
                  if f["empty"]: f["size"] = 0; continue
                  while fi < len(counts) and counts[fi] == inner: fi += 1; inner = 0; pos = 0
                  f["folder"], f["offset"], f["size"] = fi, pos, sizes[k]
                  pos += sizes[k]; inner += 1; k += 1
              return buf, pi, fs, files


          def extract(path, out, endings=()):
              """Unpacks the files whose names end with one of endings (all files if none) into out; returns their paths."""
              buf, pi, fs, files = read(path)
              endings = tuple(e.lower() for e in endings)
              done, cur, data = [], None, b""
              for f in files:
                  name = f["name"].replace("\\", "/")
                  parts = [p for p in name.split("/") if p not in ("", ".")]
                  if f["empty"] or ".." in parts or not parts or (endings and not name.lower().endswith(endings)):
                      continue
                  if f["folder"] != cur:
                      try:
                          data, cur = decode_folder(buf, pi, fs, f["folder"]), f["folder"]
                      except NotImplementedError:
                          continue
                  p = os.path.join(out, *parts)
                  os.makedirs(os.path.dirname(p), exist_ok=True)
                  with open(p, "wb") as w:
                      w.write(data[f["offset"]:f["offset"] + f["size"]])
                  done.append(p)
              return done


          if __name__ == "__main__":
              if sys.argv[1] == "list":
                  buf, pi, fs, files = read(sys.argv[2])
                  print(f"{len(files)} entries, {len(fs or [])} folders:", [[c["id"] for c in f["coders"]] for f in (fs or [])][:8])
                  for f in files: print(f"{f['size']:>10}  {f.get('folder', '-'):>3}  {f['name']}")
              else:
                  print(len(extract(sys.argv[2], sys.argv[3], sys.argv[4:])), "files extracted to", sys.argv[3])
          MRTAPP_EOF

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Create a signing key on the first run
        run: |
          mkdir -p signing
          if [ ! -f signing/mrt-tracker.jks ]; then
            keytool -genkeypair -v -keystore signing/mrt-tracker.jks -alias mrttracker \
              -keyalg RSA -keysize 2048 -validity 10000 \
              -storepass mrttracker -keypass mrttracker -dname "CN=MRT Tracker"
            git config user.name "github-actions"
            git config user.email "github-actions@users.noreply.github.com"
            git add signing/mrt-tracker.jks
            git commit -m "Add app signing key [skip ci]"
            git push
          fi

      # Downloads LTA's official train timetable and packs it into the app.
      # Never fails the build: without it, the app falls back to estimated times.
      - name: Fetch LTA train timetable
        run: python3 mrt-tracker-app/tools/build_timetable.py mrt-tracker-app data/lta-timetable.json

      # The last good timetable is kept in this repository (data/lta-timetable.json), so a build
      # where LTA's download fails still packs LTA's timetable instead of falling back to estimates.
      - name: Keep the timetable for next time
        run: |
          if [ -f data/lta-timetable.json ] && [ -n "$(git status --porcelain data/lta-timetable.json)" ]; then
            git config user.name "github-actions"
            git config user.email "github-actions@users.noreply.github.com"
            git add data/lta-timetable.json
            git commit -m "Save LTA train timetable [skip ci]"
            git pull --rebase --autostash || true
            git push || echo "::warning::The timetable couldn't be saved to the repository this time. This version of the app still has it."
          fi

      # Building outlines and heights from OpenStreetMap near every station, for the 3D buildings on
      # the map. A copy is kept between builds, so OpenStreetMap is only asked again once a month.
      # Never fails the build: without it, the map just has no buildings.
      - name: Restore saved buildings
        uses: actions/cache/restore@v4
        with:
          path: osm-cache
          key: osm-buildings-v1-${{ github.run_id }}
          restore-keys: osm-buildings-v1-

      - name: Fetch buildings from OpenStreetMap
        run: python3 mrt-tracker-app/tools/build_buildings.py mrt-tracker-app osm-cache

      - name: Fetch RTS Link and Sentosa Express tracks from OpenStreetMap
        run: |
          if [ -f mrt-tracker-app/tools/build_tracks.py ]; then
            python3 mrt-tracker-app/tools/build_tracks.py mrt-tracker-app osm-cache
          fi

      - name: Save buildings for next time
        if: hashFiles('osm-fresh') != ''
        uses: actions/cache/save@v4
        with:
          path: osm-cache
          key: osm-buildings-v1-${{ github.run_id }}

      # Train sounds for the Drive game: SMRTOSG's OpenBVE trains by Danish Rusdi (SG5937C), used with
      # permission. A copy is kept between builds, so a train is only downloaded again when SMRTOSG
      # releases a new version of it. Never fails the build: without them, the game makes its own sounds.
      - name: Restore saved train sounds
        uses: actions/cache/restore@v4
        with:
          path: sound-cache
          key: train-sounds-v1-${{ github.run_id }}
          restore-keys: train-sounds-v1-

      - name: Fetch train sounds (OpenBVE)
        run: |
          if [ -f mrt-tracker-app/tools/build_sounds.py ]; then
            python3 mrt-tracker-app/tools/build_sounds.py mrt-tracker-app sound-cache
          fi

      - name: Save train sounds for next time
        if: hashFiles('sounds-fresh') != ''
        uses: actions/cache/save@v4
        with:
          path: sound-cache
          key: train-sounds-v1-${{ github.run_id }}

      # The page intentionally does NOT use a script fingerprint. This prevents UI edits from
      # silently invalidating the WebView page. Keep a syntax check so broken JavaScript still fails fast.
      - name: Check the app page JavaScript
        run: |
          python3 - mrt-tracker-app/app/src/main/assets/index.html <<'PY'
          import os, re, subprocess, sys, tempfile
          path = sys.argv[1]
          page = open(path, encoding="utf-8").read()
          scripts = re.findall(r"<script>(.*?)</script>", page, re.S)
          if not scripts:
              print("⚠️ The page has no inline script; skipped JavaScript check.")
              raise SystemExit(0)
          with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False, encoding="utf-8") as f:
              f.write("\n".join(scripts))
              name = f.name
          try:
              r = subprocess.run(["node", "--check", name], capture_output=True, text=True, timeout=120)
              if r.returncode != 0:
                  print("❌ The page JavaScript has a syntax error:")
                  print(r.stderr)
                  raise SystemExit(1)
              print("✅ Page JavaScript syntax check passed. No script fingerprint is used.")
          except (FileNotFoundError, subprocess.TimeoutExpired):
              print("⚠️ Node isn't available; skipped the JavaScript syntax check.")
          finally:
              try: os.unlink(name)
              except OSError: pass
          PY

      - name: Build the app
        env:
          # Claude API key for the Ask tab (optional). Without it, the Ask tab gives built-in answers.
          ORG_GRADLE_PROJECT_aiKey: ${{ secrets.ANTHROPIC_API_KEY }}
          ORG_GRADLE_PROJECT_googleKey: ${{ env.CHANNEL == 'dev' && secrets.GOOGLE_MAPS_API_KEY || '' }}
        run: |
          if [ -n "$ORG_GRADLE_PROJECT_aiKey" ]; then
            echo "🤖 **Ask tab:** Claude answers (the ANTHROPIC_API_KEY secret is set)." >> "$GITHUB_STEP_SUMMARY"
          else
            echo "🤖 **Ask tab:** built-in answers only. Add an ANTHROPIC_API_KEY secret to let Claude answer." >> "$GITHUB_STEP_SUMMARY"
          fi
          # Version from the build time, so every new build installs over the last one,
          # whatever this workflow file is called.
          VC=$(( ( $(date +%s) - 1767225600 ) / 60 ))
          VN=$(TZ=Asia/Singapore date +%Y.%m.%d-%H%M)
          APK=mrt-tracker.apk
          if [ "$CHANNEL" = "dev" ]; then VN="$VN-dev"; APK=mrt-dev.apk; fi
          echo "VN=$VN" >> "$GITHUB_ENV"
          echo "APK=$APK" >> "$GITHUB_ENV"
          # The public repo the app checks for updates. MRT Dev is private, so it isn't put there and
          # doesn't check for updates: each new build is installed from this repo's Releases.
          UPDATE_REPO="${{ github.repository_owner }}/mrt-tracker-releases"
          if [ "$CHANNEL" = "dev" ]; then UPDATE_REPO=""; fi
          gradle -p mrt-tracker-app assembleRelease -Pvc=$VC -Pvn=$VN -Pchannel="$CHANNEL" -PupdateRepo="$UPDATE_REPO" -PaiKey="$ORG_GRADLE_PROJECT_aiKey" -PgoogleKey="$ORG_GRADLE_PROJECT_googleKey" -Pks="$GITHUB_WORKSPACE/signing/mrt-tracker.jks"
          cp mrt-tracker-app/app/build/outputs/apk/release/app-release.apk "$APK"
          printf '{"versionCode":%s,"versionName":"%s"}\n' "$VC" "$VN" > version.json

      - uses: actions/upload-artifact@v4
        with:
          name: ${{ env.CHANNEL == 'dev' && 'mrt-dev-apk' || 'mrt-tracker-apk' }}
          path: ${{ env.APK }}

      - name: Publish to Releases
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          # MRT Tracker goes in the "latest" release; MRT Dev in a separate "dev" pre-release.
          if [ "$CHANNEL" = "dev" ]; then
            gh release delete dev --yes --cleanup-tag || true
            gh release create dev "$APK" --title "MRT Dev $VN" --prerelease --latest=false \
              --notes "MRT Dev, the developer app for trying new features. Download mrt-dev.apk on your Android phone and open it to install. It installs next to MRT Tracker and doesn't change it."
          else
            gh release delete latest --yes --cleanup-tag || true
            gh release create latest "$APK" --title "MRT Tracker $VN" \
              --notes "Download mrt-tracker.apk on your Android phone and open it to install."
          fi

      # Publishes MRT Tracker to your public "mrt-tracker-releases" repo, where the app looks for
      # updates. Needs the RELEASES_TOKEN secret; skipped if it isn't set. MRT Dev is never published
      # there (it's only for you); a dev build removes any copy an older build put there.
      - name: Publish update for the app
        env:
          RELEASES_TOKEN: ${{ secrets.RELEASES_TOKEN }}
          PUB_REPO: ${{ github.repository_owner }}/mrt-tracker-releases
        run: |
          if [ -z "$RELEASES_TOKEN" ]; then
            [ "$CHANNEL" = "dev" ] || echo "::warning::RELEASES_TOKEN isn't set, so the app won't be told about this update."
            exit 0
          fi
          export GH_TOKEN="$RELEASES_TOKEN"
          if [ "$CHANNEL" = "dev" ]; then
            gh release delete dev --repo "$PUB_REPO" --yes --cleanup-tag || true
            exit 0
          fi
          gh release delete latest --repo "$PUB_REPO" --yes --cleanup-tag || true
          gh release create latest "$APK" version.json --repo "$PUB_REPO" --title "MRT Tracker $VN" \
            --notes "Open MRT Tracker and tap Update, or download mrt-tracker.apk to install."
